    let problems = [];

    const select = document.getElementById("problem-select");
    const title = document.getElementById("problem-title");
    const description = document.getElementById("problem-description");
    const instructions = document.getElementById("problem-instructions");
    const codeArea = document.getElementById("practice-code");
    const highlightedCode = document.querySelector("#highlighted-code code");
    const highlightedPre = document.getElementById("highlighted-code");
    const gameLink = document.getElementById("game-link");
    const status = document.getElementById("status");

    // 指定されたファイルをテキストとして読み込む
    async function fetchText(path) {
      const response = await fetch(path);

      if (!response.ok) {
        throw new Error(
          `${path} を読み込めませんでした（HTTP ${response.status}）`
        );
      }

      return response.text();
    }

    // コードのシンタックスハイライトを更新する
    function updateHighlight() {
      const code = codeArea.value;

      highlightedCode.innerHTML = hljs.highlight(
        code,
        { language: "python" }
      ).value;

      // 最後の改行がある場合も表示位置を維持する
      if (code.endsWith("\n")) {
        highlightedCode.innerHTML += "\n";
      }

      syncScroll();
    }

    // 編集領域とハイライト表示のスクロール位置を同期する
    function syncScroll() {
      highlightedPre.scrollTop = codeArea.scrollTop;
      highlightedPre.scrollLeft = codeArea.scrollLeft;
    }

    // 問題を表示する
    async function showProblem(id) {
      const problem = problems.find(item => item.id === id);

      if (!problem) {
        status.textContent = "指定された問題が見つかりません。";
        return;
      }

      title.textContent = `${problem.id}：${problem.title}`;
      description.textContent = problem.description || "";

      instructions.replaceChildren();

      for (const instruction of problem.instructions || []) {
        const li = document.createElement("li");
        li.textContent = instruction;
        instructions.appendChild(li);
      }

      // ファイル名は問題番号から自動生成する
      const practicePath = `./p${problem.id}.py`;
      const gamePath = `./${problem.id}.html`;

      gameLink.href = gamePath;
      codeArea.value = "";
      updateHighlight();

      status.textContent = `${practicePath} を読み込んでいます……`;

      select.value = problem.id;

      // URLに現在の問題番号を反映する
      const url = new URL(window.location.href);
      url.searchParams.set("id", problem.id);
      history.replaceState(null, "", url);

      try {
        codeArea.value = await fetchText(practicePath);
        updateHighlight();
        status.textContent = "";
      } catch (error) {
        status.textContent = error.message;
      }
    }

    // 初期化
    async function main() {
      try {
        const yamlText = await fetchText("./problems.yaml");
        problems = jsyaml.load(yamlText);

        if (!Array.isArray(problems) || problems.length === 0) {
          throw new Error("問題データが空か、形式が正しくありません。");
        }

        select.replaceChildren();

        for (const problem of problems) {
          const option = document.createElement("option");
          option.value = problem.id;
          option.textContent = `${problem.id}：${problem.title}`;
          select.appendChild(option);
        }

        select.addEventListener("change", () => {
          showProblem(select.value);
        });

        // コードを編集したときにハイライトを更新する
        codeArea.addEventListener("input", updateHighlight);

        // スクロール位置を同期する
        codeArea.addEventListener("scroll", syncScroll);

        // URLの ?id=01 から初期表示する問題を決定する
        const requestedId = new URLSearchParams(
          window.location.search
        ).get("id");

        const initialProblem = problems.find(
          problem => problem.id === requestedId
        ) || problems[0];

        await showProblem(initialProblem.id);

      } catch (error) {
        title.textContent = "読み込みエラー";
        status.textContent = error.message;
      }
    }

    main();
  </script>
